# Deployment env for docker-compose.server.yml and docker-compose.release.yml
#
# Copy to .env and fill in real values before `make start`. Never commit
# the resulting .env (it's in .gitignore).

# --- Database ---
POSTGRES_PASSWORD=change-this-db-password

# --- App / API ---
SECRET_KEY=change-this-jwt-secret-key-min-32-characters
# When set, /api/v1/auth/shuake-token issues a 7-day compat token. Min 32 chars.
SHUAKE_COMPAT_SECRET=
# Origins allowed to call the API with cookies/Authorization. Must NOT be "*"
# when ENV=production; HTTPS-only is enforced unless the host is localhost.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Extra hostnames/IPs the site may be opened with (comma separated), e.g. a LAN
# IP or a second domain. localhost, 127.0.0.1 and the CORS_ORIGINS hosts are
# always allowed. Requests for any other Host get 400 "Invalid host header".
ALLOWED_HOSTS=
# Server administrators (comma-separated emails). They see the new-version
# notice. Empty = the first registered account is the administrator.
ADMIN_EMAILS=
# Poll GitHub Releases for new versions (set to false on air-gapped servers).
UPDATE_CHECK_ENABLED=true
APP_PORT=8000
# Public web port for docker-compose.release.yml (the deploy scripts write this
# variable from --port / -Port; docker-compose.server.yml has no web service).
HTTP_PORT=8080
# Tag your environment: "production" enables strict CORS/HTTPS guards.
ENV=production

# --- Crypto ---
# Third-party credential at-rest encryption (urlsafe-base64 Fernet key).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production (ENV=production); in dev a missing key falls back to
# plaintext storage with a loud warning.
CREDENTIAL_ENCRYPTION_KEY=

# --- Email (verification codes for register / password reset) ---
# Off by default: registration keeps working without any SMTP setup. Set to
# true only once SMTP_HOST and SMTP_FROM below are filled in.
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=smtp.example.com
# 465 with SMTP_SSL=true (implicit TLS), or 587 with SMTP_SSL=false (STARTTLS).
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-this-smtp-password
# Envelope/From address; usually the same mailbox as SMTP_USER.
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=学道

# --- Optional knobs ---
# BCRYPT_ROUNDS=12          # clamped 4..15 by app/core/security.py
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR
# LOG_FORMAT=json           # plain (default) or json (one-line per record)
# DOCS_ENABLED=false        # set true to expose /docs and /openapi.json
# BAIDU_MAP_API_KEY=        # opt-in: Baidu Maps API for the location picker

# --- Backups (scripts/db_backup.sh) ---
# AGE_RECIPIENT=age1...     # encrypt dumps for this recipient
# AGE_RECIPIENT_FILE=/etc/uh/age-recipients.txt
# RETAIN_DAYS=14            # how long to keep encrypted dumps locally
