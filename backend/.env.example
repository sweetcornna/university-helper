# Database
MAIN_DB_HOST=localhost
MAIN_DB_NAME=main_db
MAIN_DB_USER=postgres
MAIN_DB_PASSWORD=postgres
MAIN_DB_PORT=5432

# JWT
# SECRET_KEY: required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Third-party credential at-rest encryption (urlsafe-base64 Fernet key).
# CREDENTIAL_ENCRYPTION_KEY: required in production (ENV=production / APP_ENV=production).
# In dev, a missing key falls back to plaintext storage with a loud warning.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Email verification (registration codes + password reset).
# Off by default: registration keeps working without any SMTP setup. Set to
# true only once SMTP_HOST and SMTP_FROM below are filled in AND the main
# database has been migrated (`alembic upgrade main_db@head` creates the
# email_verification_codes table); otherwise send-code answers 503.
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=smtp.example.com
# 465 with SMTP_SSL=true (implicit TLS), or 587 with SMTP_SSL=false (STARTTLS).
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-this-smtp-password
# Envelope/From address; usually the same mailbox as SMTP_USER.
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=学道

# Optional legacy compatibility token for the shuake client.
# SHUAKE_COMPAT_SECRET: leave empty to disable. If set, MUST be >= 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SHUAKE_COMPAT_SECRET=
