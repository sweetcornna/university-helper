# syntax=docker/dockerfile:1.7

# ---------- builder ----------
FROM python:3.11-slim AS builder

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN if [ -f /etc/apt/sources.list.d/debian.sources ] && echo "${PIP_INDEX_URL}" | grep -q tsinghua; then \
        sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; \
        printf '%s\n' tsinghua > /tmp/apt-mirror-selection; \
    else \
        printf '%s\n' debian > /tmp/apt-mirror-selection; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Chaoxing encrypted-font decoding needs a glyph-hash mapping table maintained
# by Samueli924/chaoxing. Keep the GPL-3.0 data out of this MIT repository and
# fetch a pinned upstream revision while building the server image instead.
ARG CHAOXING_FONT_MAP_URL=https://raw.githubusercontent.com/Samueli924/chaoxing/556ccc1556823ff5c8dc1ac4ad26307217b25795/resource/font_map_table.json
ARG CHAOXING_FONT_MAP_SHA256=792786beba0acc8bdfe4ff7e6f8624bf69e8d4d7d9a72cb6a9453c4ff6cd87e7
RUN CHAOXING_FONT_MAP_URL="$CHAOXING_FONT_MAP_URL" CHAOXING_FONT_MAP_SHA256="$CHAOXING_FONT_MAP_SHA256" python - <<'PYFONT'
import hashlib
import json
import os
import urllib.request
from pathlib import Path

url = os.environ["CHAOXING_FONT_MAP_URL"]
expected = os.environ["CHAOXING_FONT_MAP_SHA256"].lower()
target = Path("/build/resource/font_map_table.json")
target.parent.mkdir(parents=True, exist_ok=True)

with urllib.request.urlopen(url, timeout=60) as response:
    payload = response.read()

actual = hashlib.sha256(payload).hexdigest()
if actual != expected:
    raise SystemExit(f"font_map_table.json SHA-256 mismatch: expected {expected}, got {actual}")

parsed = json.loads(payload)
if not isinstance(parsed, dict) or not parsed:
    raise SystemExit("font_map_table.json is not a non-empty JSON object")

target.write_bytes(payload)
print(f"Downloaded Chaoxing font map: {len(parsed)} entries, sha256={actual}")
PYFONT

COPY backend/requirements.txt /build/requirements.txt
RUN pip wheel --wheel-dir=/wheels --default-timeout=1000 \
        -r /build/requirements.txt email-validator

# ---------- runtime ----------
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INDEX=1

COPY --from=builder /tmp/apt-mirror-selection /tmp/apt-mirror-selection
RUN if [ -f /etc/apt/sources.list.d/debian.sources ] && [ "$(cat /tmp/apt-mirror-selection)" = tsinghua ]; then \
        sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g; s|security.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
        libpq5 tini \
    && rm -rf /var/lib/apt/lists/* /tmp/apt-mirror-selection \
    && groupadd -r app --gid 10001 \
    && useradd -r -g app --uid 10001 --home-dir /srv/backend --shell /usr/sbin/nologin app

WORKDIR /srv/backend

COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --find-links=/wheels --no-index $(ls /wheels/*.whl) \
    && rm -rf /wheels

COPY --chown=app:app backend /srv/backend
COPY --from=builder --chown=app:app /build/resource/font_map_table.json /srv/backend/resource/font_map_table.json
# Schema files for app/db/bootstrap.py: lets the app rebuild the users table and
# tenant_template when the Postgres init scripts never ran on this volume.
COPY --chown=app:app database/00-schema.sql database/templates/tenant_template.sql /srv/backend/app/db/sql/

USER app

EXPOSE 8000

# --workers must stay 1 until ChaoxingSigninManager._clients is moved to a
# shared store. Each uvicorn worker is a separate Python process with its
# own in-memory _clients dict, so a login on worker A is invisible to
# /courses requests routed to workers B/C/D — see signin.py:1156. uvloop
# and httptools still help in single-worker mode.
#
# --proxy-headers makes uvicorn honor X-Forwarded-Proto / X-Forwarded-For from
# the upstream proxy so request.url.scheme reflects the real client scheme
# (lets the app-level HTTPS redirect / HSTS work behind nginx without a redirect
# loop, and feeds the rate limiter the real client IP). --forwarded-allow-ips
# governs which immediate peers are trusted to set those headers. We use "*"
# because this container is never exposed directly: docker-compose publishes it
# only on 127.0.0.1:8000 behind the host nginx, which OVERWRITES X-Forwarded-For
# with $remote_addr (see nginx/proxy_params.conf) so a client cannot spoof it.
# PROD-VERIFY: if you ever expose this port beyond the local nginx, pin
# --forwarded-allow-ips to the nginx/load-balancer container IP(s) instead of "*".
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--loop", "uvloop", "--http", "httptools", "--proxy-headers", "--forwarded-allow-ips", "*"]
